{
  "version": 2,
  "name": "learn-classical-frontend",
  "builds": [
    { "src": "backend/static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/backend/static/index.html" },
    { "src": "^/backend/static/(.*)$", "dest": "/backend/static/$1" },
    { "src": "^/api/(.*)$", "dest": "https://YOUR_BACKEND_HOST/$1" }
  ]
}
